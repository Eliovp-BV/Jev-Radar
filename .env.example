TYPESAFE_API_KEY=YOUR_KEY_HERE
JEV_MODEL=jev-1.13.0
# Listen on all IPv4 interfaces for trusted LAN access; use 127.0.0.1 for local-only.
RADAR_HOST=0.0.0.0
RADAR_PORT=8787
RADAR_DATA_DIR=data
# Required for automatic general-web discovery; optional for supplied-site research.
BRAVE_SEARCH_API_KEY=
# Optional generative assistant: choose a provider/model in Settings after
# adding ONE matching key here, then click Reload keys. Jev still makes choices.
OPENAI_API_KEY=
# Google AI Studio key; GOOGLE_API_KEY is an accepted alias. GEMINI_API_KEY wins.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Other services with the OpenAI chat-completions protocol (HTTPS only).
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
# Initial selection only; a saved Settings selection takes precedence.
TEXT_MODEL_PROVIDER=disabled
TEXT_MODEL_MODEL=
# Optional initial price estimates for TEXT_MODEL_PROVIDER + TEXT_MODEL_MODEL.
# You can set model-specific rates in Settings; known OpenAI GPT-4.1 / GPT-4.1-mini and Gemini 3.8 Flash rates
# are supplied automatically. Unknown models require both rates before inference.
# Settings → Spend limits defaults to $5 Jev / $20 text per investigation.
TEXT_MODEL_INPUT_USD_PER_MILLION=
TEXT_MODEL_OUTPUT_USD_PER_MILLION=
# Optional account-specific rates; blank uses the documented public list price.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
JEV_PRICING_SOURCE=
# Conservative process-wide concurrency caps (1–4 HTTP/Jev, 1–2 browser).
RADAR_HTTP_CONCURRENCY=4
RADAR_JEV_CONCURRENCY=4
RADAR_BROWSER_CONTEXTS=1
# Set only for live development checks; retains the persistent cumulative ledger.
# Its original 200/$2 cap changes only through an explicit operator-authorized
# .runtime/development-limits.json (max_calls, jev_usd, text_usd).
RADAR_DEV_LIVE_TEST=0
# Public operator contact URL for the descriptive bot User-Agent.
RADAR_CONTACT_URL=
